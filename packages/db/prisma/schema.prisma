// Prisma schema for FabXpert
// Database: Supabase (Postgres) — used as managed Postgres only.
// See docs/architecture.md for the domain model and design decisions.

generator client {
  provider = "prisma-client-js"
  // relationJoins lets a query opt into `relationLoadStrategy: "join"`, which
  // loads includes in the same statement instead of one round trip per
  // relation. The database is a hop away from the API, so those round trips
  // dominate list endpoints.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  CIORNA           // Draft
  IN_OFERTARE      // Quotation
  CASTIGAT         // Awarded
  IN_PROIECTARE    // Engineering
  IN_PRODUCTIE     // In Production
  PREGATIT_LIVRARE // Ready for Delivery
  LIVRAT           // Delivered
  FINALIZAT        // Completed
  SUSPENDAT        // On Hold
  ANULAT           // Cancelled
}

enum LeaveType {
  ODIHNA     // Annual leave — consumes annualLeaveDays balance when approved
  MEDICAL    // Medical leave — does not affect balance
  NEPLATIT   // Unpaid leave — does not affect balance
  RECUPERARE // Time off in lieu — consumes the overtime balance when approved
}

enum LeaveStatus {
  IN_ASTEPTARE // Pending review (default)
  APROBAT      // Approved
  RESPINS      // Rejected
}

enum NotificationKind {
  TIMESHEET_REMINDER // "You haven't logged time yet" nudge, sent by an admin
  ANNOUNCEMENT       // Free-text message (admin-sent)
  POLL               // A poll was published and is waiting for an answer
}

enum NotificationSource {
  SYSTEM // Generated by the app itself
  ADMIN  // Sent by an admin; `createdByUserId` says who
}

enum PollStatus {
  DRAFT  // Being written by an admin; employees don't see it
  OPEN   // Published — collecting answers
  CLOSED // No longer accepting answers; results stay readable
}

// ---------------------------------------------------------------------------
// EmployeeRole
// Admin-managed lookup table for job roles (e.g. "Sudor", "Vopsitor").
// Not an enum — rows are managed at runtime, not compile-time.
// ---------------------------------------------------------------------------

model EmployeeRole {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  persons Person[]

  visibleForProjects Project[]

  @@map("employee_roles")
}

// ---------------------------------------------------------------------------
// Activity
// Admin-managed lookup table for work activities (e.g. "Sudare", "Vopsire").
// Not an enum — rows are managed at runtime, not compile-time.
// Same structural pattern as EmployeeRole.
// ---------------------------------------------------------------------------

model Activity {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  isActive  Boolean   @default(true)
  /// When true, logging this activity asks which assemblies were worked on.
  /// A flag rather than a hardcoded name list, because activity rows are
  /// renamed at runtime and the feature must not switch off silently.
  tracksAssemblies Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  timesheets Timesheet[]

  assemblyLinks TimesheetAssembly[]

  @@map("activities")
}

// ---------------------------------------------------------------------------
// Person
// Represents an employee (name, contact info). Not every Person has a User.
// ---------------------------------------------------------------------------

model Person {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  /// Yearly ODIHNA entitlement (admin-editable). Balance is computed, not stored.
  annualLeaveDays Int   @default(21)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Optional link to a job role — can be assigned after creation.
  employeeRoleId String?
  employeeRole   EmployeeRole? @relation(fields: [employeeRoleId], references: [id])

  // A User always maps to exactly one Person; back-reference is optional.
  user User?

  // Timesheets where this Person is the subject of the logged time.
  timesheets Timesheet[]

  leaveRequests LeaveRequest[]

  overtimeAccruals OvertimeAccrual[]

  @@map("persons")
}

// ---------------------------------------------------------------------------
// User
// Represents a login account. Always linked to exactly one Person.
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  /// When true, employee only sees projects explicitly assigned to their role (not "Toți").
  restrictedProjects Boolean @default(false)
  /// Office staff: listed under "Office" in admin and never counted as "nu a pontat". Always true for ADMIN.
  isOfficeUser Boolean @default(false)
  /// External employee (colaborator), tracked separately from restrictedProjects.
  angajatExtern Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Required: every User must reference exactly one Person.
  personId String @unique
  person   Person @relation(fields: [personId], references: [id])

  // Timesheets created/entered by this User (may differ from the Person whose time is logged).
  timesheets Timesheet[]

  reviewedLeaveRequests LeaveRequest[]

  notifications     Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationAuthor")
  pushSubscriptions PushSubscription[]

  createdPolls Poll[]     @relation("PollAuthor")
  pollVotes    PollVote[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Company
// Represents a client — the beneficiary of fabrication projects.
// Not a platform tenant; not a supplier (MVP scope).
// ---------------------------------------------------------------------------

model Company {
  id                  String    @id @default(uuid())
  name                String
  taxCode             String?
  tradeRegistryNumber String?
  registeredAddress   String?
  phone               String?
  deliveryAddress     String?
  legalRepresentative String?
  email               String?
  contactPerson       String?
  contactPersonPhone  String?
  color               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  projects Project[]

  @@map("companies")
}

// ---------------------------------------------------------------------------
// Project
// Belongs to exactly one Company (the client). No multi-company association in MVP.
// ---------------------------------------------------------------------------

model Project {
  id                String        @id @default(uuid())
  name              String
  denumireLucrare   String?
  finisaj           String?
  /// Project weight in kilograms; null until filled in.
  weight            Float?
  /// Estimated hours of work for the project; null until filled in.
  estimatedHours    Float?
  /// Free-text admin notes about the project.
  notes             String?
  /// Derived in Postgres (GENERATED ALWAYS AS ... STORED) from `status`: rank for the
  /// default list order — IN_PRODUCTIE first, FINALIZAT last. Never write it from the app;
  /// keep the generation expression when editing this column (see the 20260811230000 migration).
  /// `dbgenerated()` is what keeps Prisma from putting the column in INSERTs — Postgres
  /// rejects any explicit value for a generated column (SQLSTATE 428C9). The expression
  /// below mirrors how Prisma introspects the column, so the schema stays drift-free.
  statusRank        Int           @default(dbgenerated("\nCASE status\n    WHEN 'IN_PRODUCTIE'::\"ProjectStatus\" THEN 0\n    WHEN 'CIORNA'::\"ProjectStatus\" THEN 1\n    WHEN 'IN_OFERTARE'::\"ProjectStatus\" THEN 2\n    WHEN 'CASTIGAT'::\"ProjectStatus\" THEN 3\n    WHEN 'IN_PROIECTARE'::\"ProjectStatus\" THEN 4\n    WHEN 'PREGATIT_LIVRARE'::\"ProjectStatus\" THEN 5\n    WHEN 'LIVRAT'::\"ProjectStatus\" THEN 6\n    WHEN 'SUSPENDAT'::\"ProjectStatus\" THEN 7\n    WHEN 'ANULAT'::\"ProjectStatus\" THEN 8\n    WHEN 'FINALIZAT'::\"ProjectStatus\" THEN 9\n    ELSE 99\nEND"))
  code              String        @unique
  status            ProjectStatus @default(CIORNA)
  startDate         DateTime?
  dueDate           DateTime?
  /// Set when the project transitions into FINALIZAT (cleared if it leaves that status).
  /// Backfilled once from `updatedAt` for projects already FINALIZAT. Drives the
  /// Rapoarte analytics: a project is in an interval when `completedAt` falls inside it.
  completedAt       DateTime?
  readyForExecution Boolean       @default(false)
  isPinned          Boolean       @default(false)
  indexPanou          Int?
  panouColumn         Int?
  color             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  timesheets Timesheet[]

  assemblies ProjectAssembly[]

  visibleForRoles EmployeeRole[]

  @@index([deletedAt, status])
  /// Matches the default list order; created in the 20260811230000 migration.
  @@index([statusRank, startDate])
  /// Rapoarte analytics: fetch FINALIZAT projects by completion date range.
  @@index([status, completedAt])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Timesheet
// Records time logged by a Person against a Project.
// personId  — whose time is being logged.
// userId    — who created/entered the record (may differ, e.g. admin logging on behalf).
// activityId — optional; can be assigned after the entry is created.
// workDate  — calendar day the work was done (stored as DateTime at local midnight; time ignored).
// durationMinutes — whole minutes worked (e.g. 90 = 1h30m).
// ---------------------------------------------------------------------------

model Timesheet {
  id              String    @id @default(uuid())
  workDate        DateTime  @default(now())
  durationMinutes Int
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  personId String
  person   Person @relation(fields: [personId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])

  assemblies TimesheetAssembly[]

  @@index([deletedAt, workDate])
  @@index([personId])
  @@index([projectId])
  /// Rapoarte analytics: hours grouped by activity.
  @@index([activityId])
  @@map("timesheets")
}

// ---------------------------------------------------------------------------
// LeaveRequest
// Employee leave requests with admin approval workflow.
// Balance for ODIHNA is computed from approved requests — not stored on Person.
// ---------------------------------------------------------------------------

model LeaveRequest {
  id        String       @id @default(uuid())
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  status    LeaveStatus  @default(IN_ASTEPTARE)
  reason    String?
  /// RECUPERARE taken as hours instead of whole days: minutes off on startDate,
  /// which then equals endDate. Null everywhere else — that means whole days.
  durationMinutes Int?
  reviewedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  personId String
  person   Person @relation(fields: [personId], references: [id])

  reviewedByUserId String?
  reviewedBy       User?   @relation(fields: [reviewedByUserId], references: [id])

  @@index([deletedAt, status, startDate, endDate])
  @@index([personId, type, status, startDate])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// OvertimeAccrual
// One closed month of overtime for one Person. A working day counts for what it
// is over or short of DAILY_WORK_MINUTES, so a month can close negative — it is
// derivable from timesheets, but a closed month is frozen here: editing an old
// timesheet afterwards must not silently rewrite a balance people already
// spent. Months with no row are recomputed live, as the current month always is.
// ---------------------------------------------------------------------------

model OvertimeAccrual {
  id String @id @default(uuid())

  /// First day of the month this row closes, at midnight.
  month DateTime
  /// Overtime balance for that month, frozen at closing time. Negative when the
  /// person logged fewer hours than the contractual days they worked.
  earnedMinutes Int
  closedAt      DateTime @default(now())

  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@unique([personId, month])
  @@index([personId])
  @@map("overtime_accruals")
}

// ---------------------------------------------------------------------------
// Notification
// In-app message for one user. Survives app restarts and stays visible until
// the user dismisses it — `dismissedAt` is the only thing that hides it.
// Push delivery is a separate best-effort channel (see PushSubscription); the
// row is the source of truth either way.
// ---------------------------------------------------------------------------

model Notification {
  id     String             @id @default(uuid())
  kind   NotificationKind
  source NotificationSource @default(SYSTEM)
  title  String
  body   String
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// Set when an admin sent it by hand; null for SYSTEM notifications.
  createdByUserId String?
  createdBy       User?   @relation("NotificationAuthor", fields: [createdByUserId], references: [id])

  /// Set on POLL notifications; cleared automatically once the user answers.
  pollId String?
  poll   Poll?  @relation(fields: [pollId], references: [id], onDelete: Cascade)

  /// Drives the mobile "what's still on screen" fetch.
  @@index([userId, dismissedAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// PushSubscription
// One Web Push endpoint per browser/device a user allowed notifications on.
// The keys are what the browser handed us; we only ever pass them to web-push.
// Rows are pruned when the push service reports the endpoint is gone (404/410).
// ---------------------------------------------------------------------------

model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String
  /// Kept only to tell devices apart when debugging a "didn't get it" report.
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Poll
// A question an admin asks the team ("Schimbare oră începere lucru"), with a
// custom list of options. Draft polls are invisible to employees; publishing
// opens it for answers and notifies everyone. Answers are attributed — an
// admin sees who voted what, employees only see the counts.
// ---------------------------------------------------------------------------

model Poll {
  id          String     @id @default(uuid())
  title       String
  description String?
  /// Voters may pick more than one option.
  allowMultiple Boolean  @default(false)
  status      PollStatus @default(DRAFT)
  /// Answers stop being accepted at this moment; null means "until closed by hand".
  closesAt    DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  createdByUserId String
  createdBy       User   @relation("PollAuthor", fields: [createdByUserId], references: [id])

  options PollOption[]
  votes   PollVote[]
  notifications Notification[]

  @@index([deletedAt, status, publishedAt])
  @@map("polls")
}

model PollOption {
  id    String @id @default(uuid())
  label String
  /// Display order inside the poll, 0-based.
  position Int

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes PollVote[]

  @@index([pollId, position])
  @@map("poll_options")
}

// One answer: a user picking one option. A multi-choice poll stores one row per
// picked option, so a plain count per option is always the answer count.
model PollVote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@map("poll_votes")
}

// ---------------------------------------------------------------------------
// SteelProfile
// Catalogue of profiles seen across assembly lists, keyed by the normalized
// spelling. Rows are created on demand by the import — never a gate, so a new
// plate size can never block a list from coming in. `kgPerMeter` is the hook
// for computing piece weight later; the drawing lists compute it today.
// ---------------------------------------------------------------------------

model SteelProfile {
  /// Normalized spelling — see normalizeProfileKey in @fabxpert/shared.
  key String @id
  /// First spelling seen for this profile, kept for display.
  label String
  /// Mass per metre in kg; null until the catalogue is filled in.
  kgPerMeter Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assemblies ProjectAssembly[]

  @@map("steel_profiles")
}

// ---------------------------------------------------------------------------
// ProjectAssembly
// One line of a project's assembly list, as it appears on the drawing: a mark
// ("GBAL/25"), how many pieces it covers, its profile and length.
//
// Deliberately carries NO progress column. How much of it is done is derived
// from the timesheets that covered it (see TimesheetAssembly) — the same rule
// the leave balance follows. A stored counter would drift the moment someone
// corrects an old timesheet, and nobody "spends" a finished assembly the way
// OvertimeAccrual's frozen months are spent.
// ---------------------------------------------------------------------------

model ProjectAssembly {
  id String @id @default(uuid())
  /// Assembly mark from the drawing, e.g. "GBAL/25".
  name String
  /// Pieces this line covers — the number of tick boxes on the paper list.
  quantity Int
  /// Profile exactly as imported, e.g. "CFCHS48.3*3.6"; shown as-is so it
  /// matches what the worker reads on the drawing.
  profile String?
  /// `profile` normalized, for grouping and the SteelProfile join.
  profileKey String?
  /// Piece length in millimetres. Not whole numbers: drawing lists carry values
  /// like 2981.6, which the sheet only rounds for display.
  length Float?
  /// Kilograms for one piece, as the drawing list states it. Not derived from
  /// the profile — the list already did that sum and is the reference.
  weightPerPiece Float?
  /// Import order, so the list keeps the drawing's sequence.
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  steelProfile SteelProfile? @relation(fields: [profileKey], references: [key])

  timesheetLinks TimesheetAssembly[]

  /// Re-importing a revised list updates rows instead of duplicating them.
  @@unique([projectId, name])
  @@index([projectId, deletedAt, position])
  @@index([profileKey])
  @@map("project_assemblies")
}

// ---------------------------------------------------------------------------
// TimesheetAssembly
// "This timesheet covered N pieces of that assembly." The only place assembly
// progress is written; totals are grouped from here.
// ---------------------------------------------------------------------------

model TimesheetAssembly {
  id String @id @default(uuid())
  /// Pieces of the assembly this timesheet covered.
  quantityDone Int
  createdAt    DateTime @default(now())

  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  assemblyId String
  assembly   ProjectAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  /// Copied from the timesheet. Progress is reported per activity ("3 of 7
  /// welded"), and Prisma cannot group by a field reached through a relation —
  /// so the key lives here too. It is a copied foreign key, not an aggregate:
  /// rewritten in the same transaction whenever the timesheet's activity moves.
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  @@unique([timesheetId, assemblyId])
  /// Backs the grouped progress query.
  @@index([assemblyId, activityId])
  @@map("timesheet_assemblies")
}
